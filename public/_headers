# Cross-Origin-Isolation: schaltet SharedArrayBuffer und damit
# Multi-Threading fuer die Sprach-Engine frei (der Worker nutzt dann
# automatisch mehrere Kerne statt einem - siehe worker.ts numThreads).
# GitHub Pages kann solche Header nicht setzen, Netlify liest diese Datei
# direkt aus dem Deploy-Verzeichnis.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

# Unveraenderliche Dateien duerfen ewig gecacht werden: gehashte
# Build-Assets und die versionierten onnxruntime-Laufzeitdateien.
# Spart bei jedem Besuch Revalidierungs-Roundtrips (Lighthouse:
# "efficient cache policy").
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/ort/*
  Cache-Control: public, max-age=31536000, immutable

# Die Sprachmodelle aendern sich nur mit einer neuen Modellfassung, und
# eine solche kaeme unter neuen Dateinamen. Lange Cache-Zeiten helfen
# hier doppelt: Ein abgebrochener 400-MB-Download setzt beim naechsten
# Versuch auf dem HTTP-Cache auf, statt alles erneut zu uebertragen.
/supertonic/*
  Cache-Control: public, max-age=31536000, immutable
