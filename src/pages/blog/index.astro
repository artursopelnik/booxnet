---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categoryLabels: Record<string, string> = {
  news: 'News',
  review: 'Review',
  comparison: 'Vergleich',
  guide: 'Guide',
};

const categories = ['news', 'review', 'comparison', 'guide'] as const;

// Get category from URL
const url = Astro.url;
const activeCategory = url.searchParams.get('category') ?? 'all';

const filtered = activeCategory === 'all'
  ? sortedPosts
  : sortedPosts.filter(p => p.data.category === activeCategory);
---

<BaseLayout
  title="Blog – Alle Artikel"
  description="Alle News, Reviews, Vergleiche und Guides rund um ONYX BOOX E-Ink-Tablets und E-Reader."
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 py-10">
    <header class="mb-8">
      <h1 class="text-3xl font-bold text-ink-900 mb-2">Blog</h1>
      <p class="text-stone-500">News, Reviews, Vergleiche und Guides zu ONYX BOOX Geräten</p>
    </header>

    <!-- Category Filter -->
    <div class="flex flex-wrap items-center gap-2 mb-8 pb-6 border-b border-stone-200">
      <a
        href="/blog"
        class:list={[
          'rounded-full px-4 py-1.5 text-sm font-medium transition-colors',
          activeCategory === 'all'
            ? 'bg-ink-900 text-white'
            : 'bg-stone-100 text-stone-600 hover:bg-stone-200',
        ]}
      >
        Alle ({allPosts.length})
      </a>
      {categories.map(cat => {
        const count = allPosts.filter(p => p.data.category === cat).length;
        return (
          <a
            href={`/blog?category=${cat}`}
            class:list={[
              'rounded-full px-4 py-1.5 text-sm font-medium transition-colors',
              activeCategory === cat
                ? 'bg-ink-900 text-white'
                : 'bg-stone-100 text-stone-600 hover:bg-stone-200',
            ]}
          >
            {categoryLabels[cat]} ({count})
          </a>
        );
      })}
    </div>

    <!-- Articles Grid -->
    {filtered.length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {filtered.map(post => (
          <ArticleCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            category={post.data.category}
            slug={post.slug}
            coverImage={post.data.coverImage}
            tags={post.data.tags}
          />
        ))}
      </div>
    ) : (
      <div class="py-20 text-center">
        <p class="text-stone-400 text-lg">Keine Artikel in dieser Kategorie.</p>
        <a href="/blog" class="mt-4 inline-block text-accent-600 hover:underline text-sm">Alle Artikel anzeigen</a>
      </div>
    )}
  </div>
</BaseLayout>
