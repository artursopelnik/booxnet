---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const all    = await getCollection('posts');
const sorted = all.sort((a,b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const cats = ['news','review','comparison','guide'] as const;
const catLabels: Record<string,string> = { news:'News', review:'Review', comparison:'Vergleich', guide:'Guide' };

const seriesList = ['tab','note','go','palma','general'] as const;
const seriesLabels: Record<string,string> = {
  tab:'Tab-Serie', note:'Note-Serie', go:'Go-Serie', palma:'Palma', general:'Allgemein',
};

function rt(body?: string) { return Math.max(1, Math.ceil((body?.split(/\s+/).length ?? 0) / 200)); }
---

<BaseLayout
  title="Blog – Alle Artikel"
  description="Alle News, Reviews, Vergleiche und Guides rund um ONYX BOOX E-Ink-Tablets."
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 py-10">

    <!-- Page header -->
    <header class="mb-8 pb-6 border-b border-ink-200">
      <h1 class="font-display font-black text-3xl sm:text-4xl text-ink-900 mb-1 tracking-tight">Blog</h1>
      <p class="text-ink-500 text-sm">News, Reviews, Vergleiche und Guides zu ONYX BOOX Geräten</p>
    </header>

    <!-- Category tabs (client-side filter) -->
    <nav class="mb-5" aria-label="Kategorien">
      <div class="flex items-end gap-0 border-b-2 border-ink-200 overflow-x-auto">
        <a href="/blog" data-filter-cat="all" class="filter-tab flex-shrink-0 px-4 pb-2.5 pt-1 text-sm font-semibold transition-all border-b-2 -mb-[2px] border-transparent text-ink-500 hover:text-ink-900 hover:border-ink-300">
          Alle
          <span class="tab-count ml-1.5 inline-flex items-center justify-center rounded-sm text-[10px] font-bold px-1.5 py-0.5 bg-ink-100 text-ink-500">{all.length}</span>
        </a>
        {cats.map(cat => {
          const count = all.filter(p => p.data.category === cat).length;
          return (
            <a href={`/blog?category=${cat}`} data-filter-cat={cat} class="filter-tab flex-shrink-0 px-4 pb-2.5 pt-1 text-sm font-semibold transition-all border-b-2 -mb-[2px] border-transparent text-ink-500 hover:text-ink-900 hover:border-ink-300">
              {catLabels[cat]}
              <span class="tab-count ml-1.5 inline-flex items-center justify-center rounded-sm text-[10px] font-bold px-1.5 py-0.5 bg-ink-100 text-ink-500">{count}</span>
            </a>
          );
        })}
      </div>
    </nav>

    <!-- Series chips (client-side filter) -->
    <nav class="mb-8 flex items-center gap-2 overflow-x-auto" aria-label="Geräte-Serien">
      <span class="text-2xs font-bold uppercase tracking-editorial text-ink-400 mr-1 flex-shrink-0">Serie</span>
      <a href="/blog" data-filter-series="all"
        class="filter-chip flex-shrink-0 rounded-full border border-ink-300 px-3.5 py-1.5 text-xs font-semibold text-ink-600 hover:border-ink-900 hover:text-ink-900 transition-colors">
        Alle
      </a>
      {seriesList.map(s => {
        const count = all.filter(p => p.data.series === s).length;
        return count > 0 && (
          <a href={`/blog?series=${s}`} data-filter-series={s}
            class="filter-chip flex-shrink-0 rounded-full border border-ink-300 px-3.5 py-1.5 text-xs font-semibold text-ink-600 hover:border-ink-900 hover:text-ink-900 transition-colors">
            {seriesLabels[s]}
          </a>
        );
      })}
    </nav>

    <!-- Grid — all posts rendered, JS toggles visibility -->
    <div id="post-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {sorted.map(p => (
        <div class="post-item" data-category={p.data.category} data-series={p.data.series}>
          <ArticleCard
            title={p.data.title}
            description={p.data.description}
            pubDate={p.data.pubDate}
            category={p.data.category}
            slug={p.slug}
            coverImage={p.data.coverImage}
            readingTime={rt(p.body)}
            variant="default"
          />
        </div>
      ))}
    </div>

    <!-- Empty state (shown by JS when no post matches) -->
    <div id="empty-state" class="py-24 text-center hidden">
      <svg class="mx-auto h-12 w-12 text-ink-300 mb-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m6.75 12H9m1.5-12H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/>
      </svg>
      <p class="text-ink-500 font-medium">Keine Artikel für diese Auswahl.</p>
      <a href="/blog" class="mt-3 inline-block rounded-full border border-ink-300 px-4 py-2 text-sm text-ink-700 hover:border-ink-900 hover:text-ink-900 font-medium transition-colors">Filter zurücksetzen</a>
    </div>
  </div>
</BaseLayout>

<script>
  /* Static-build-safe filtering: read URL params on load, toggle cards.
     (Astro.url.searchParams is empty at build time, so filtering must run client-side.) */
  const params   = new URLSearchParams(window.location.search);
  const category = params.get('category') ?? 'all';
  const series   = params.get('series') ?? 'all';

  const items = document.querySelectorAll<HTMLElement>('.post-item');
  let visible = 0;
  items.forEach(item => {
    const show =
      (category === 'all' || item.dataset.category === category) &&
      (series === 'all' || item.dataset.series === series);
    item.classList.toggle('hidden', !show);
    if (show) visible++;
  });

  document.getElementById('empty-state')?.classList.toggle('hidden', visible > 0);

  /* Active states */
  document.querySelectorAll<HTMLElement>('.filter-tab').forEach(tab => {
    if (tab.dataset.filterCat === category) {
      tab.classList.remove('border-transparent', 'text-ink-500');
      tab.classList.add('border-accent-500', 'text-accent-600');
      const count = tab.querySelector('.tab-count');
      count?.classList.remove('bg-ink-100', 'text-ink-500');
      count?.classList.add('bg-accent-100', 'text-accent-700');
      tab.setAttribute('aria-current', 'true');
    }
  });
  document.querySelectorAll<HTMLElement>('.filter-chip').forEach(chip => {
    if (chip.dataset.filterSeries === series) {
      chip.classList.remove('border-ink-300', 'text-ink-600');
      chip.classList.add('bg-ink-900', 'border-ink-900', 'text-ink-50');
      chip.setAttribute('aria-current', 'true');
    }
  });

  /* Combined filters: tab links keep the active series, chip links keep the active category */
  document.querySelectorAll<HTMLAnchorElement>('.filter-tab').forEach(tab => {
    const url = new URL(tab.href);
    if (series !== 'all') url.searchParams.set('series', series);
    tab.href = url.pathname + url.search;
  });
  document.querySelectorAll<HTMLAnchorElement>('.filter-chip').forEach(chip => {
    const url = new URL(chip.href);
    if (category !== 'all') url.searchParams.set('category', category);
    chip.href = url.pathname + url.search;
  });
</script>
