---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categoryLabels: Record<string, string> = {
  news: 'News', review: 'Review', comparison: 'Vergleich', guide: 'Guide',
};

const categories = ['news', 'review', 'comparison', 'guide'] as const;

const activeCategory = Astro.url.searchParams.get('category') ?? 'all';

const filtered = activeCategory === 'all'
  ? sortedPosts
  : sortedPosts.filter(p => p.data.category === activeCategory);

function readingTime(body: string | undefined) {
  return Math.max(1, Math.ceil((body?.split(/\s+/).length ?? 0) / 200));
}
---

<BaseLayout
  title="Blog – Alle Artikel"
  description="Alle News, Reviews, Vergleiche und Guides rund um ONYX BOOX E-Ink-Tablets und E-Reader."
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 py-10">

    <!-- Page header -->
    <header class="mb-8">
      <h1 class="text-3xl font-extrabold text-ink-900 mb-1 tracking-tight">Blog</h1>
      <p class="text-stone-500">News, Reviews, Vergleiche und Guides zu ONYX BOOX Geräten</p>
    </header>

    <!-- Tab-style category filter -->
    <div class="mb-8" role="navigation" aria-label="Kategorien filtern">
      <div class="flex items-end gap-0 border-b-2 border-stone-200 overflow-x-auto">
        <a
          href="/blog"
          class:list={[
            'flex-shrink-0 px-4 pb-2.5 pt-1 text-sm font-semibold transition-all border-b-2 -mb-[2px]',
            activeCategory === 'all'
              ? 'border-accent-500 text-accent-700'
              : 'border-transparent text-stone-500 hover:text-ink-900 hover:border-stone-300',
          ]}
        >
          Alle
          <span class:list={[
            'ml-1.5 inline-flex items-center justify-center rounded-full text-[10px] font-bold px-1.5 py-0.5 min-w-[1.25rem]',
            activeCategory === 'all' ? 'bg-accent-100 text-accent-700' : 'bg-stone-100 text-stone-500',
          ]}>
            {allPosts.length}
          </span>
        </a>

        {categories.map(cat => {
          const count = allPosts.filter(p => p.data.category === cat).length;
          const isActive = activeCategory === cat;
          return (
            <a
              href={`/blog?category=${cat}`}
              class:list={[
                'flex-shrink-0 px-4 pb-2.5 pt-1 text-sm font-semibold transition-all border-b-2 -mb-[2px]',
                isActive
                  ? 'border-accent-500 text-accent-700'
                  : 'border-transparent text-stone-500 hover:text-ink-900 hover:border-stone-300',
              ]}
            >
              {categoryLabels[cat]}
              <span class:list={[
                'ml-1.5 inline-flex items-center justify-center rounded-full text-[10px] font-bold px-1.5 py-0.5 min-w-[1.25rem]',
                isActive ? 'bg-accent-100 text-accent-700' : 'bg-stone-100 text-stone-500',
              ]}>
                {count}
              </span>
            </a>
          );
        })}
      </div>
    </div>

    <!-- Articles grid -->
    {filtered.length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {filtered.map(post => (
          <ArticleCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            category={post.data.category}
            slug={post.slug}
            coverImage={post.data.coverImage}
            tags={post.data.tags}
            readingTime={readingTime(post.body)}
          />
        ))}
      </div>
    ) : (
      <div class="py-24 text-center">
        <div class="text-5xl mb-4 opacity-30">🔍</div>
        <p class="text-stone-500 text-lg font-medium">Keine Artikel in dieser Kategorie.</p>
        <a href="/blog" class="mt-4 inline-block text-accent-600 hover:underline text-sm font-medium">Alle Artikel anzeigen</a>
      </div>
    )}
  </div>
</BaseLayout>
