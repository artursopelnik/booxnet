---
import PostLayout from '../../../layouts/PostLayout.astro';
import { getLocalizedPosts } from '../../../i18n/content';
import { locales, defaultLocale, type Locale } from '../../../i18n/ui';

export async function getStaticPaths() {
  const langs = locales.filter(l => l !== defaultLocale);
  const paths = [];
  for (const lang of langs) {
    const posts = await getLocalizedPosts(lang);
    for (const { slug, entry } of posts) {
      paths.push({
        params: { lang, slug },
        props: { post: entry, cleanSlug: slug },
      });
    }
  }
  return paths;
}

const { post, cleanSlug } = Astro.props;
const lang = Astro.params.lang as Locale;
const { Content, headings } = await post.render();
---

<PostLayout post={post} slug={cleanSlug} headings={headings} lang={lang}>
  <Content />
</PostLayout>
