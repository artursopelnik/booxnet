---
import BaseLayout from './BaseLayout.astro';
import AffiliateDisclosure from '../components/AffiliateDisclosure.astro';
import TableOfContents from '../components/TableOfContents.astro';
import ArticleCard from '../components/ArticleCard.astro';
import type { CollectionEntry } from 'astro:content';
import { getLocalizedPosts } from '../i18n/content';
import { type Locale, useTranslations, localizePath, defaultLocale, dateLocale } from '../i18n/ui';

interface Props {
  post: CollectionEntry<'posts'>;
  /** Clean slug without locale prefix (used in URLs) */
  slug: string;
  headings: { depth: number; slug: string; text: string }[];
  lang?: Locale;
}

const { post, slug, headings, lang = defaultLocale } = Astro.props;
const { title, description, pubDate, updatedDate, category, coverImage, tags, affiliateLinks } = post.data;
const t = useTranslations(lang);

const catLabels: Record<string,string> = {
  news: t('cat.news'), review: t('cat.review'), comparison: t('cat.comparison'), guide: t('cat.guide'),
};

const wordCount  = post.body?.split(/\s+/).length ?? 0;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));

const fmt = (d: Date) => d.toLocaleDateString(dateLocale[lang], { day:'numeric', month:'long', year:'numeric' });

const allPosts = await getLocalizedPosts(lang);
const related  = allPosts.filter(p => p.slug !== slug && p.entry.data.category === category).slice(0, 3);
const hasAff   = affiliateLinks && affiliateLinks.length > 0;

const blogPath = localizePath(lang, '/blog');

function rt(body?: string) { return Math.max(1, Math.ceil((body?.split(/\s+/).length ?? 0) / 200)); }
---

<BaseLayout title={title} description={description} type="article" pubDate={pubDate} ogImage={coverImage} lang={lang}>

  <!-- Reading progress -->
  <div id="reading-progress" aria-hidden="true"></div>

  <!-- White reading surface on gray canvas -->
  <div class="bg-white border-b border-ink-200">

  <!-- Breadcrumb -->
  <nav class="mx-auto max-w-3xl px-4 sm:px-6 pt-5" aria-label="Breadcrumb">
    <ol class="flex items-center flex-wrap gap-1 text-xs text-ink-400">
      <li><a href={localizePath(lang, '/')} class="hover:text-ink-900 transition-colors">{t('nav.home')}</a></li>
      <li aria-hidden="true" class="text-ink-300">/</li>
      <li><a href={blogPath} class="hover:text-ink-900 transition-colors">{t('blog.title')}</a></li>
      <li aria-hidden="true" class="text-ink-300">/</li>
      <li>
        <a href={`${blogPath}?category=${category}`}
          class="cat-badge py-0.5 hover:opacity-80">
          {catLabels[category]}
        </a>
      </li>
      <li aria-hidden="true" class="text-ink-300">/</li>
      <li class="text-ink-500 truncate max-w-[180px]" aria-current="page">{title}</li>
    </ol>
  </nav>

  <!-- Article header -->
  <article class="mx-auto max-w-3xl px-4 sm:px-6 py-8">
    <header class="mb-8">
      <div class="flex items-center gap-2 mb-4">
        <span class="cat-badge">{catLabels[category]}</span>
        <span class="text-ink-300" aria-hidden="true">·</span>
        <span class="text-xs text-ink-400 flex items-center gap-1.5">
          <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8 1a7 7 0 100 14A7 7 0 008 1zm.5 3.25a.75.75 0 00-1.5 0V8c0 .2.08.39.22.53l2 2a.75.75 0 101.06-1.06L8.5 7.69V4.25z"/>
          </svg>
          {readingTime} {t('post.readingTime')}
        </span>
      </div>

      <h1 class="font-display font-black text-[2rem] sm:text-[2.4rem] text-ink-900 leading-[1.15] tracking-tight mb-4">
        {title}
      </h1>

      <p class="text-lg text-ink-500 leading-relaxed mb-5">{description}</p>

      <div class="flex flex-wrap items-center gap-x-5 gap-y-1 text-xs text-ink-400 border-t border-ink-100 pt-4">
        <time datetime={pubDate.toISOString()}>
          {t('post.published')} <strong class="text-ink-600 font-medium">{fmt(pubDate)}</strong>
        </time>
        {updatedDate && (
          <time datetime={updatedDate.toISOString()}>
            {t('post.updated')} <strong class="text-ink-600 font-medium">{fmt(updatedDate)}</strong>
          </time>
        )}
      </div>

      {tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5 mt-3">
          {tags.map(tag => (
            <span class="inline-flex items-center rounded bg-ink-100 px-2 py-0.5 text-xs font-medium text-ink-600">
              #{tag}
            </span>
          ))}
        </div>
      )}
    </header>

    <!-- Cover image -->
    {coverImage && (
      <div class="mb-8 rounded-xl overflow-hidden shadow-md" style="aspect-ratio:16/9">
        <img src={coverImage} alt={title} class="w-full h-full object-cover" loading="eager" />
      </div>
    )}

    <!-- Affiliate disclosure -->
    {hasAff && <AffiliateDisclosure lang={lang} />}

    <!-- TOC -->
    <TableOfContents headings={headings} lang={lang} />

    <!-- Body -->
    <div class="prose-article">
      <slot />
    </div>

    <!-- Bottom disclosure -->
    {hasAff && (
      <div class="mt-10 pt-5 border-t border-ink-100">
        <AffiliateDisclosure compact lang={lang} />
      </div>
    )}

    <!-- Affiliate product links -->
    {hasAff && affiliateLinks && (
      <div class="mt-5 rounded-xl border border-ink-200 bg-ink-50 p-5">
        <p class="text-2xs font-bold uppercase tracking-editorial text-ink-400 mb-3">{t('post.products')}</p>
        <ul class="space-y-2">
          {affiliateLinks.map(link => (
            <li>
              <a href={link.url} target="_blank" rel="noopener noreferrer nofollow"
                class="flex items-center gap-2 text-sm font-medium text-link hover:underline transition-colors">
                <svg class="h-4 w-4 flex-shrink-0 opacity-60" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M4.25 5.5a.75.75 0 00-.75.75v8.5c0 .414.336.75.75.75h8.5a.75.75 0 00.75-.75v-4a.75.75 0 011.5 0v4A2.25 2.25 0 0112.75 17h-8.5A2.25 2.25 0 012 14.75v-8.5A2.25 2.25 0 014.25 4h5a.75.75 0 010 1.5h-5z" clip-rule="evenodd"/>
                  <path fill-rule="evenodd" d="M6.194 12.753a.75.75 0 001.06.053L16.5 4.44v2.81a.75.75 0 001.5 0v-4.5a.75.75 0 00-.75-.75h-4.5a.75.75 0 000 1.5h2.553l-9.056 8.194a.75.75 0 00-.053 1.06z" clip-rule="evenodd"/>
                </svg>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}

    <!-- Back link -->
    <div class="mt-10 pt-6 border-t border-ink-100">
      <a href={blogPath} class="inline-flex items-center gap-2 text-sm font-medium text-ink-500 hover:text-ink-900 transition-colors">
        <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M17 10a.75.75 0 01-.75.75H5.61l4.16 3.96a.75.75 0 11-1.04 1.08l-5.5-5.25a.75.75 0 010-1.08l5.5-5.25a.75.75 0 111.04 1.08L5.61 9.25H16.25A.75.75 0 0117 10z" clip-rule="evenodd"/>
        </svg>
        {t('post.back')}
      </a>
    </div>
  </article>
  </div>

  <!-- Related articles — on gray canvas -->
  {related.length > 0 && (
    <section class="py-12">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div class="section-label">{t('post.related')}</div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {related.map(p => (
            <ArticleCard
              title={p.entry.data.title}
              description={p.entry.data.description}
              pubDate={p.entry.data.pubDate}
              category={p.entry.data.category}
              slug={p.slug}
              coverImage={p.entry.data.coverImage}
              readingTime={rt(p.entry.body)}
              variant="default"
              lang={lang}
            />
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<script>
  const bar = document.getElementById('reading-progress');
  if (bar) {
    const tick = () => {
      const { scrollTop, scrollHeight, clientHeight } = document.documentElement;
      bar.style.width = scrollHeight === clientHeight
        ? '0%'
        : `${Math.min((scrollTop / (scrollHeight - clientHeight)) * 100, 100)}%`;
    };
    document.addEventListener('scroll', tick, { passive: true });
    tick();
  }
</script>
