---
import BaseLayout from './BaseLayout.astro';
import AffiliateDisclosure from '../components/AffiliateDisclosure.astro';
import TableOfContents from '../components/TableOfContents.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
  headings: { depth: number; slug: string; text: string }[];
}

const { post, headings } = Astro.props;
const { title, description, pubDate, updatedDate, category, coverImage, tags, affiliateLinks } = post.data;

const categoryLabels: Record<string, string> = {
  news: 'News',
  review: 'Review',
  comparison: 'Vergleich',
  guide: 'Guide',
};

const formattedPubDate = pubDate.toLocaleDateString('de-DE', {
  day: 'numeric', month: 'long', year: 'numeric',
});
const formattedUpdatedDate = updatedDate?.toLocaleDateString('de-DE', {
  day: 'numeric', month: 'long', year: 'numeric',
});

// Estimate reading time from word count
const wordCount = post.body?.split(/\s+/).length ?? 0;
const readingTime = Math.ceil(wordCount / 200);

// Get related posts (same category, excluding current)
const allPosts = await getCollection('posts');
const related = allPosts
  .filter(p => p.slug !== post.slug && p.data.category === category)
  .slice(0, 3);
const hasAffiliate = affiliateLinks && affiliateLinks.length > 0;
---

<BaseLayout title={title} description={description} type="article" pubDate={pubDate} ogImage={coverImage}>
  <article class="mx-auto max-w-3xl px-4 sm:px-6 py-10">
    <!-- Article Header -->
    <header class="mb-8">
      <div class="flex items-center gap-2 mb-4">
        <span class:list={['category-badge', `category-${category}`]}>
          {categoryLabels[category] ?? category}
        </span>
        <span class="text-xs text-stone-400">{readingTime} Min. Lesezeit</span>
      </div>

      <h1 class="text-2xl sm:text-3xl font-bold text-ink-900 leading-tight mb-4">
        {title}
      </h1>
      <p class="text-lg text-stone-500 leading-relaxed mb-4">{description}</p>

      <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-stone-400">
        <time datetime={pubDate.toISOString()}>
          Veröffentlicht: {formattedPubDate}
        </time>
        {updatedDate && (
          <time datetime={updatedDate.toISOString()}>
            Aktualisiert: {formattedUpdatedDate}
          </time>
        )}
      </div>

      {tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5 mt-4">
          {tags.map(tag => (
            <span class="inline-flex items-center rounded-full bg-stone-100 px-2.5 py-0.5 text-xs font-medium text-stone-600">
              #{tag}
            </span>
          ))}
        </div>
      )}
    </header>

    <!-- Cover Image -->
    {coverImage && (
      <div class="mb-8 rounded-xl overflow-hidden aspect-video bg-stone-100">
        <img src={coverImage} alt={title} class="w-full h-full object-cover" />
      </div>
    )}

    <!-- Affiliate Disclosure (if article has affiliate links) -->
    {hasAffiliate && <AffiliateDisclosure />}

    <!-- Table of Contents -->
    <TableOfContents headings={headings} />

    <!-- Article Body -->
    <div class="prose-article">
      <slot />
    </div>

    <!-- Affiliate Disclosure at bottom (if article has affiliate links) -->
    {hasAffiliate && (
      <div class="mt-10 pt-6 border-t border-stone-100">
        <AffiliateDisclosure compact />
      </div>
    )}

    <!-- Affiliate Product Links -->
    {hasAffiliate && affiliateLinks && affiliateLinks.length > 0 && (
      <div class="mt-6 rounded-xl border border-stone-200 bg-stone-50 p-5">
        <h3 class="text-sm font-semibold text-ink-900 mb-3">Im Artikel erwähnte Produkte</h3>
        <ul class="space-y-2">
          {affiliateLinks.map(link => (
            <li>
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer nofollow"
                class="flex items-center gap-2 text-sm text-accent-700 hover:underline"
              >
                <svg class="h-4 w-4 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M4.25 5.5a.75.75 0 00-.75.75v8.5c0 .414.336.75.75.75h8.5a.75.75 0 00.75-.75v-4a.75.75 0 011.5 0v4A2.25 2.25 0 0112.75 17h-8.5A2.25 2.25 0 012 14.75v-8.5A2.25 2.25 0 014.25 4h5a.75.75 0 010 1.5h-5z" clip-rule="evenodd" />
                  <path fill-rule="evenodd" d="M6.194 12.753a.75.75 0 001.06.053L16.5 4.44v2.81a.75.75 0 001.5 0v-4.5a.75.75 0 00-.75-.75h-4.5a.75.75 0 000 1.5h2.553l-9.056 8.194a.75.75 0 00-.053 1.06z" clip-rule="evenodd" />
                </svg>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </article>

  <!-- Related Articles -->
  {related.length > 0 && (
    <section class="border-t border-stone-200 bg-stone-50 py-12">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <h2 class="text-xl font-bold text-ink-900 mb-6">Ähnliche Artikel</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {related.map(p => (
            <ArticleCard
              title={p.data.title}
              description={p.data.description}
              pubDate={p.data.pubDate}
              category={p.data.category}
              slug={p.slug}
              coverImage={p.data.coverImage}
              tags={p.data.tags}
            />
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
