---
interface Device {
  name: string;
  [key: string]: string;
}

interface Props {
  devices: Device[];
  specs: { key: string; label: string }[];
  title?: string;
}

const { devices, specs, title = 'Geräte-Vergleich' } = Astro.props;
---

<div class="not-prose my-8 overflow-x-auto rounded-xl border border-ink-200">
  {title && (
    <div class="bg-ink-900 px-4 py-3">
      <h3 class="font-display text-sm font-bold text-ink-50">{title}</h3>
    </div>
  )}
  <table class="w-full text-sm">
    <thead>
      <tr class="border-b border-ink-200">
        <th class="bg-ink-100 px-4 py-3 text-left text-2xs font-bold text-ink-500 uppercase tracking-editorial w-32">
          Eigenschaft
        </th>
        {devices.map(device => (
          <th class="bg-ink-100 px-4 py-3 text-left text-xs font-semibold text-ink-900">
            {device.name}
          </th>
        ))}
      </tr>
    </thead>
    <tbody>
      {specs.map((spec, i) => (
        <tr class:list={['border-b border-ink-100 last:border-0', i % 2 === 1 ? 'bg-ink-50' : 'bg-white']}>
          <td class="px-4 py-3 text-xs font-medium text-ink-500">{spec.label}</td>
          {devices.map(device => (
            <td class="px-4 py-3 text-ink-800">{device[spec.key] ?? '–'}</td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>
