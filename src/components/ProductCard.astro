---
interface Props {
  name: string;
  description: string;
  image?: string;
  price?: string;
  affiliateUrl: string;
  affiliateLabel?: string;
  badge?: string;
}

const {
  name,
  description,
  image,
  price,
  affiliateUrl,
  affiliateLabel = 'Auf Amazon ansehen',
  badge,
} = Astro.props;
---

<div class="not-prose rounded-xl border border-stone-200 bg-white p-5 flex gap-4 my-6 shadow-sm">
  {image && (
    <div class="flex-shrink-0 w-24 h-24 rounded-lg overflow-hidden bg-stone-100">
      <img src={image} alt={name} class="w-full h-full object-contain p-2" loading="lazy" />
    </div>
  )}
  {!image && (
    <div class="flex-shrink-0 w-24 h-24 rounded-lg bg-stone-100 flex items-center justify-center text-3xl text-stone-300">
      📱
    </div>
  )}

  <div class="flex flex-col flex-1 gap-2">
    <div class="flex items-start gap-2 flex-wrap">
      <h3 class="font-semibold text-ink-900 text-sm leading-tight">{name}</h3>
      {badge && (
        <span class="inline-flex items-center rounded-full bg-accent-100 px-2 py-0.5 text-xs font-medium text-accent-700">
          {badge}
        </span>
      )}
    </div>
    <p class="text-xs text-stone-500 leading-relaxed">{description}</p>
    <div class="flex items-center gap-3 mt-auto">
      {price && (
        <span class="text-sm font-semibold text-ink-900">{price}</span>
      )}
      <a
        href={affiliateUrl}
        target="_blank"
        rel="noopener noreferrer nofollow"
        class="inline-flex items-center gap-1.5 rounded-lg bg-amber-400 px-3 py-1.5 text-xs font-semibold text-ink-900 hover:bg-amber-500 transition-colors"
      >
        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor">
          <path d="M10 6v2H5v11h11v-5h2v7H3V6h7zm11-3v8h-2V6.413l-7.293 7.294-1.414-1.414L17.585 5H13V3h8z"/>
        </svg>
        {affiliateLabel}
      </a>
    </div>
  </div>
</div>
