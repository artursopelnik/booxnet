---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../ArticleCard.astro';
import SeriesPanel from '../SeriesPanel.astro';
import { getCollection } from 'astro:content';
import { type Locale, useTranslations, localizePath } from '../../i18n/ui';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const all   = await getCollection('posts');
const posts = all.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const seriesList = ['tab', 'note', 'go', 'palma'] as const;
const seriesCount = (s: string) => all.filter(p => p.data.series === s).length;

function rt(body?: string) { return Math.max(1, Math.ceil((body?.split(/\s+/).length ?? 0) / 200)); }

const featured = posts[0];
const sidebar  = posts.slice(1, 4);
const grid     = posts.slice(1);

const catLabels: Record<string,string> = {
  news: t('cat.news'), review: t('cat.review'), comparison: t('cat.comparison'), guide: t('cat.guide'),
};
---

<BaseLayout
  title="booxnet.com"
  description={t('home.subtitle')}
  lang={lang}
>

  <!-- HERO — on gray page canvas -->
  <section class="border-b border-ink-200">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 py-12 sm:py-16 text-center">
      <p class="text-2xs font-bold uppercase tracking-editorial text-ink-400 mb-4">
        {t('home.kicker')}
      </p>
      <h1 class="font-display font-black text-4xl sm:text-5xl lg:text-6xl text-ink-900 leading-[1.08] tracking-tight mb-5">
        {t('home.title1')}
        <span class="text-ink-500">{t('home.title2')}</span>
      </h1>
      <p class="text-ink-500 text-lg max-w-xl mx-auto leading-relaxed mb-8">
        {t('home.subtitle')}
      </p>
      <div class="flex items-center justify-center gap-3">
        <a href={localizePath(lang, '/blog')}
          class="rounded-full bg-ink-900 px-6 py-2.5 text-sm font-semibold text-white hover:bg-ink-700 transition-colors">
          {t('home.cta.articles')}
        </a>
        <a href="/about"
          class="rounded-full border border-ink-300 bg-transparent px-6 py-2.5 text-sm font-semibold text-ink-700 hover:border-ink-900 hover:text-ink-900 transition-colors">
          {t('home.cta.about')}
        </a>
      </div>
    </div>
  </section>

  <!-- FEATURED — white surface section -->
  {featured && (
    <section class="bg-white border-b border-ink-200">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 py-12">
        <div class="section-label">{t('home.featured')}</div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-8">

          <!-- Featured – overlay card, 2/3 width -->
          <div class="lg:col-span-2 min-h-[420px]">
            <ArticleCard
              title={featured.data.title}
              description={featured.data.description}
              pubDate={featured.data.pubDate}
              category={featured.data.category}
              slug={featured.slug}
              coverImage={featured.data.coverImage}
              readingTime={rt(featured.body)}
              variant="overlay"
              lang={lang}
            />
          </div>

          <!-- Sidebar – horizontal mini-cards -->
          <div class="flex flex-col justify-between">
            <p class="text-2xs font-bold uppercase tracking-editorial text-ink-400 pb-3 border-b border-ink-200">
              {t('home.moreArticles')}
            </p>
            {sidebar.map(p => (
              <ArticleCard
                title={p.data.title}
                description={p.data.description}
                pubDate={p.data.pubDate}
                category={p.data.category}
                slug={p.slug}
                coverImage={p.data.coverImage}
                readingTime={rt(p.body)}
                variant="horizontal"
                lang={lang}
              />
            ))}
            <a href={localizePath(lang, '/blog')}
              class="mt-3 inline-flex items-center gap-1.5 text-xs font-semibold text-ink-700 hover:text-ink-900 transition-colors">
              {t('home.allArticles')}
              <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.64L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.15-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- DEVICE SERIES — white tiles on gray canvas -->
  <section>
    <div class="mx-auto max-w-6xl px-4 sm:px-6 py-12">
      <div class="flex items-end justify-between mb-6">
        <div>
          <p class="text-2xs font-bold uppercase tracking-editorial text-ink-400 mb-2">{t('series.kicker')}</p>
          <h2 class="font-display font-bold text-2xl text-ink-900 tracking-tight">{t('series.title')}</h2>
        </div>
        <div class="hidden sm:flex items-center gap-2">
          {(['news','review','comparison','guide'] as const).map(cat => (
            <a href={localizePath(lang, `/blog?category=${cat}`)}
              class="cat-badge hover:opacity-80 transition-opacity py-1 px-2.5">
              {catLabels[cat]}
            </a>
          ))}
        </div>
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        {seriesList.map(s => (
          <SeriesPanel series={s} count={seriesCount(s)} lang={lang} />
        ))}
      </div>
    </div>
  </section>

  <!-- ARTICLE GRID — white surface section -->
  {grid.length > 0 && (
    <section class="bg-white border-t border-ink-200">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 py-12">
        <div class="section-label">{t('home.allArticles')}</div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {grid.map(p => (
            <ArticleCard
              title={p.data.title}
              description={p.data.description}
              pubDate={p.data.pubDate}
              category={p.data.category}
              slug={p.slug}
              coverImage={p.data.coverImage}
              readingTime={rt(p.body)}
              variant="default"
              lang={lang}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- DISCLAIMER STRIP -->
  <section class="border-t border-ink-200 bg-ink-100 py-6">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <p class="text-xs text-ink-500 text-center max-w-2xl mx-auto leading-relaxed">
        {t('home.disclaimer')}
        <a href="/about" class="text-ink-700 hover:underline font-medium ml-1">{t('home.learnMore')}</a>
      </p>
    </div>
  </section>
</BaseLayout>
