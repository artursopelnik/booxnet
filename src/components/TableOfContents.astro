---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const filtered = headings.filter(h => h.depth <= 3);
---

{filtered.length > 2 && (
  <nav
    class="not-prose my-8 rounded-2xl border border-stone-200 bg-stone-50 p-5"
    aria-label="Inhaltsverzeichnis"
  >
    <p class="flex items-center gap-2 text-xs font-bold text-stone-500 uppercase tracking-wider mb-4">
      <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M2 4.75A.75.75 0 012.75 4h14.5a.75.75 0 010 1.5H2.75A.75.75 0 012 4.75zm0 10.5a.75.75 0 01.75-.75h7.5a.75.75 0 010 1.5h-7.5a.75.75 0 01-.75-.75zM2 10a.75.75 0 01.75-.75h14.5a.75.75 0 010 1.5H2.75A.75.75 0 012 10z" clip-rule="evenodd"/>
      </svg>
      Inhaltsverzeichnis
    </p>
    <ol class="space-y-1">
      {filtered.map((h, i) => (
        <li style={`padding-left: ${(h.depth - 2) * 14}px`}>
          <a
            href={`#${h.slug}`}
            class:list={[
              'group flex items-center gap-2 text-sm transition-colors py-0.5',
              h.depth === 2 ? 'text-stone-700 font-medium hover:text-accent-700' : 'text-stone-500 hover:text-accent-600',
            ]}
          >
            <span class="h-1 w-1 rounded-full bg-stone-300 group-hover:bg-accent-400 transition-colors flex-shrink-0 mt-0.5"></span>
            {h.text}
          </a>
        </li>
      ))}
    </ol>
  </nav>
)}
