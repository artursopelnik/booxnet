---
import { type Locale, useTranslations, defaultLocale } from '../i18n/ui';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  lang?: Locale;
}

const { headings, lang = defaultLocale } = Astro.props;
const t = useTranslations(lang);
const filtered = headings.filter(h => h.depth <= 3);

/* Editorial numbering: only h2 entries get an index */
let counter = 0;
const items = filtered.map(h => ({
  ...h,
  num: h.depth === 2 ? String(++counter).padStart(2, '0') : null,
}));
---

{filtered.length > 2 && (
  <nav
    class="not-prose my-8 border-y border-ink-200 py-5"
    aria-label={t('post.tocAria')}
    data-toc
  >
    <p class="text-2xs font-bold uppercase tracking-editorial text-ink-400 mb-4">
      {t('post.toc')}
    </p>
    <ol class="space-y-2">
      {items.map(h => (
        <li class:list={[h.depth === 3 && 'pl-9']}>
          <a
            href={`#${h.slug}`}
            class:list={[
              'group flex items-baseline gap-3 transition-colors',
              h.depth === 2
                ? 'text-[0.95rem] font-medium text-ink-800 hover:text-ink-600'
                : 'text-sm text-ink-500 hover:text-ink-700',
            ]}
          >
            {h.num && (
              <span class="font-mono text-2xs text-ink-300 group-hover:text-ink-500 transition-colors flex-shrink-0 tabular-nums">
                {h.num}
              </span>
            )}
            <span class="border-b border-transparent group-hover:border-ink-300 transition-colors">{h.text}</span>
          </a>
        </li>
      ))}
    </ol>
  </nav>
)}
