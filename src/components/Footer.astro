---
import { type Locale, useTranslations, localizePath, defaultLocale } from '../i18n/ui';

interface Props {
  lang?: Locale;
}
const { lang = defaultLocale } = Astro.props;
const t = useTranslations(lang);

const year = new Date().getFullYear();
---

<footer class="mt-16 bg-ink-900 text-ink-300">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 pt-14 pb-8">

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10">
      <!-- Brand -->
      <div class="lg:col-span-2">
        <a href={localizePath(lang, '/')} class="inline-block mb-4 group">
          <span class="text-xl font-black uppercase tracking-tighter text-ink-50 leading-none select-none">
            BOOXNET
          </span>
        </a>
        <p class="text-sm text-ink-400 leading-relaxed max-w-xs">
          {t('footer.tagline')}
        </p>
        <p class="mt-4 text-xs text-ink-400 leading-relaxed max-w-xs">
          {t('footer.affiliate')}
        </p>
      </div>

      <!-- Content -->
      <div>
        <h3 class="text-2xs font-bold text-ink-400 uppercase tracking-editorial mb-4">{t('footer.content')}</h3>
        <ul class="space-y-2.5">
          {[
            { href: localizePath(lang, '/blog?category=news'),       label: t('nav.news') },
            { href: localizePath(lang, '/blog?category=review'),     label: t('nav.reviews') },
            { href: localizePath(lang, '/blog?category=comparison'), label: t('nav.comparisons') },
            { href: localizePath(lang, '/blog?category=guide'),      label: t('nav.guides') },
            { href: localizePath(lang, '/blog'),                     label: t('nav.allArticles') },
          ].map(l => (
            <li>
              <a href={l.href} class="text-sm text-ink-300 hover:text-ink-50 transition-colors">
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <h3 class="text-2xs font-bold text-ink-400 uppercase tracking-editorial mb-4">{t('footer.legal')}</h3>
        <ul class="space-y-2.5">
          {[
            { href: '/about',                label: t('footer.aboutDisclaimer') },
            { href: '/affiliate-disclosure', label: t('footer.affiliateDisclosure') },
            { href: '/contact',              label: t('footer.contact') },
          ].map(l => (
            <li>
              <a href={l.href} class="text-sm text-ink-300 hover:text-ink-50 transition-colors">
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-12 pt-6 border-t border-ink-700/60 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-xs text-ink-400">
        &copy; {year} {t('footer.copyright')}
      </p>
      <p class="text-xs text-ink-400">
        {t('footer.notOfficial')}
      </p>
    </div>
  </div>
</footer>
