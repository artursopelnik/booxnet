---
const year = new Date().getFullYear();
---

<footer class="mt-16 bg-ink-900 text-ink-300">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 pt-14 pb-8">

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10">
      <!-- Brand -->
      <div class="lg:col-span-2">
        <a href="/" class="inline-flex items-center gap-2.5 mb-4 group">
          <div class="flex h-8 w-8 items-center justify-center rounded bg-ink-50 text-ink-900 select-none
                      text-xs font-black tracking-tight transition-transform group-hover:scale-105">
            BN
          </div>
          <span class="font-display font-bold text-lg text-ink-50 leading-none tracking-tight">
            booxnet<span class="text-accent-400">.</span>
          </span>
        </a>
        <p class="text-sm text-ink-400 leading-relaxed max-w-xs">
          Unabhängiger News- und Review-Blog rund um ONYX BOOX E-Ink-Tablets und E-Reader –
          nicht verbunden mit Onyx International Co., Ltd.
        </p>
        <p class="mt-4 text-xs text-ink-400 leading-relaxed max-w-xs">
          * Affiliate-Links: Bei Kauf über unsere Links erhalten wir eine Provision –
          für dich entstehen keine Mehrkosten.
        </p>
      </div>

      <!-- Inhalte -->
      <div>
        <h3 class="text-2xs font-bold text-ink-400 uppercase tracking-editorial mb-4">Inhalte</h3>
        <ul class="space-y-2.5">
          {[
            { href: '/blog?category=news',       label: 'News' },
            { href: '/blog?category=review',     label: 'Reviews' },
            { href: '/blog?category=comparison', label: 'Vergleiche' },
            { href: '/blog?category=guide',      label: 'Guides' },
            { href: '/blog',                     label: 'Alle Artikel' },
          ].map(l => (
            <li>
              <a href={l.href} class="text-sm text-ink-300 hover:text-ink-50 transition-colors">
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Rechtliches -->
      <div>
        <h3 class="text-2xs font-bold text-ink-400 uppercase tracking-editorial mb-4">Rechtliches</h3>
        <ul class="space-y-2.5">
          {[
            { href: '/about',                label: 'Über uns / Disclaimer' },
            { href: '/affiliate-disclosure', label: 'Affiliate-Disclosure' },
            { href: '/contact',              label: 'Kontakt / Impressum' },
          ].map(l => (
            <li>
              <a href={l.href} class="text-sm text-ink-300 hover:text-ink-50 transition-colors">
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-12 pt-6 border-t border-ink-700/60 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-xs text-ink-400">
        &copy; {year} booxnet.com – Inoffizielles Community-Projekt.
        Alle Markennamen sind Eigentum ihrer jeweiligen Inhaber.
      </p>
      <p class="text-xs text-ink-400">
        Kein offizielles Produkt von Onyx International Co., Ltd.
      </p>
    </div>
  </div>
</footer>
