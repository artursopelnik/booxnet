---
import { type Locale, useTranslations, defaultLocale } from '../i18n/ui';

interface Props {
  compact?: boolean;
  lang?: Locale;
}
const { compact = false, lang = defaultLocale } = Astro.props;
const t = useTranslations(lang);
---

{compact ? (
  <p class="text-xs text-ink-400 italic">
    {t('post.affiliate.compact')}
    <a href="/affiliate-disclosure" class="underline hover:text-ink-600 transition-colors ml-1">{t('post.affiliate.more')}</a>
  </p>
) : (
  <aside class="not-prose my-6 border-l-[3px] border-ink-900 bg-ink-100 py-4 pl-5 pr-4 rounded-r-lg" data-disclosure="affiliate">
    <p class="flex items-center gap-2 text-2xs font-bold uppercase tracking-editorial text-ink-600 mb-2">
      <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a.75.75 0 000 1.5h.253a.25.25 0 01.244.304l-.459 2.066A1.75 1.75 0 0010.747 15H11a.75.75 0 000-1.5h-.253a.25.25 0 01-.244-.304l.459-2.066A1.75 1.75 0 009.253 9H9z" clip-rule="evenodd" />
      </svg>
      {t('post.affiliate.label')}
    </p>
    <p class="text-sm text-ink-700 leading-relaxed">
      {t('post.affiliate.text')}
      <a href="/affiliate-disclosure" class="font-medium text-ink-900 underline decoration-ink-300 underline-offset-2 hover:decoration-ink-900 transition-colors ml-1">{t('post.affiliate.link')}</a>.
    </p>
  </aside>
)}
