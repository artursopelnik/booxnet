---
import { type Locale, locales, useTranslations, localizePath, defaultLocale } from '../i18n/ui';

interface Props {
  lang?: Locale;
}
const { lang = defaultLocale } = Astro.props;
const t = useTranslations(lang);

const currentPath = Astro.url.pathname;
/* Path without locale prefix, for the language switcher */
const basePath = lang === defaultLocale
  ? currentPath
  : currentPath.replace(new RegExp(`^/${lang}`), '') || '/';

const primaryNav = [
  { href: localizePath(lang, '/blog?category=news'),       label: t('nav.news') },
  { href: localizePath(lang, '/blog?category=review'),     label: t('nav.reviews') },
  { href: localizePath(lang, '/blog?category=comparison'), label: t('nav.comparisons') },
  { href: localizePath(lang, '/blog?category=guide'),      label: t('nav.guides') },
];

function isActive(href: string) {
  const clean = href.split('?')[0];
  if (clean === '/' || clean === `/${lang}`) return currentPath === clean;
  return currentPath.startsWith(clean);
}
---

<header class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-ink-200">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">

    <!-- Top row: logo + nav + actions -->
    <div class="flex h-14 items-center justify-between gap-6">

      <!-- Logo — BOOX-style bold wordmark -->
      <a href={localizePath(lang, '/')} class="flex-shrink-0 group" aria-label="booxnet.com – home">
        <span class="text-xl font-black uppercase tracking-tighter text-ink-900 leading-none select-none">
          BOOXNET
        </span>
      </a>

      <!-- Desktop primary nav -->
      <nav class="hidden md:flex items-center gap-0.5 flex-1 justify-center" aria-label="Main navigation">
        {primaryNav.map(link => (
          <a
            href={link.href}
            class:list={[
              'px-3.5 py-1.5 text-sm font-medium transition-colors rounded',
              isActive(link.href)
                ? 'text-ink-900 bg-ink-100'
                : 'text-ink-500 hover:text-ink-900 hover:bg-ink-100',
            ]}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Right actions -->
      <div class="hidden md:flex items-center gap-3">
        <!-- Language switcher -->
        <nav class="flex items-center gap-1" aria-label="Language">
          {locales.map(l => (
            <a
              href={l === defaultLocale ? basePath : `/${l}${basePath === '/' ? '' : basePath}`}
              class:list={[
                'px-1.5 py-1 text-2xs font-bold uppercase tracking-editorial rounded transition-colors',
                l === lang ? 'text-ink-900 bg-ink-100' : 'text-ink-400 hover:text-ink-900',
              ]}
              aria-current={l === lang ? 'true' : undefined}
            >
              {l}
            </a>
          ))}
        </nav>

        <a href={localizePath(lang, '/blog')} class="px-3 py-1.5 text-sm font-medium text-ink-500 hover:text-ink-900 transition-colors">
          {t('nav.allArticles')}
        </a>
        <a href="/about"
          class="px-4 py-1.5 rounded-full text-sm font-semibold bg-ink-900 text-ink-50 hover:bg-ink-700 transition-colors">
          {t('nav.about')}
        </a>
      </div>

      <!-- Mobile burger -->
      <button
        id="mobile-menu-button"
        class="md:hidden p-2 -mr-1 rounded text-ink-600 hover:bg-ink-100 transition-colors"
        aria-label={t('nav.menu')}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="icon-open" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg id="icon-close" class="h-5 w-5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-ink-200 bg-white">
    <nav class="mx-auto max-w-6xl px-4 py-3 flex flex-col gap-0.5" aria-label="Mobile navigation">
      {[{ href: localizePath(lang, '/'), label: t('nav.home') }, ...primaryNav, { href: '/about', label: t('nav.about') }].map(link => (
        <a
          href={link.href}
          class:list={[
            'px-3 py-2.5 rounded text-sm font-medium transition-colors',
            isActive(link.href)
              ? 'bg-ink-100 text-ink-900'
              : 'text-ink-600 hover:bg-ink-100 hover:text-ink-900',
          ]}
        >
          {link.label}
        </a>
      ))}
      <div class="flex items-center gap-1 px-3 pt-2 mt-1 border-t border-ink-100">
        {locales.map(l => (
          <a
            href={l === defaultLocale ? basePath : `/${l}${basePath === '/' ? '' : basePath}`}
            class:list={[
              'px-2 py-1.5 text-2xs font-bold uppercase tracking-editorial rounded transition-colors',
              l === lang ? 'text-ink-900 bg-ink-100' : 'text-ink-400 hover:text-ink-900',
            ]}
          >
            {l}
          </a>
        ))}
      </div>
    </nav>
  </div>
</header>

<script>
  const btn    = document.getElementById('mobile-menu-button');
  const menu   = document.getElementById('mobile-menu');
  const open   = document.getElementById('icon-open');
  const close  = document.getElementById('icon-close');

  btn?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden', isOpen);
    btn.setAttribute('aria-expanded', String(!isOpen));
    open?.classList.toggle('hidden', !isOpen);
    close?.classList.toggle('hidden', isOpen);
  });
</script>
