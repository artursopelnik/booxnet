---
const currentPath = Astro.url.pathname;

const primaryNav = [
  { href: '/blog?category=news',       label: 'News' },
  { href: '/blog?category=review',     label: 'Reviews' },
  { href: '/blog?category=comparison', label: 'Vergleiche' },
  { href: '/blog?category=guide',      label: 'Guides' },
];

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href.split('?')[0]);
}
---

<header class="sticky top-0 z-50 bg-ink-50/95 backdrop-blur-md border-b border-ink-200">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">

    <!-- Top row: logo + nav + about -->
    <div class="flex h-14 items-center justify-between gap-6">

      <!-- Logo -->
      <a href="/" class="flex items-center gap-2.5 flex-shrink-0 group" aria-label="booxnet.com – zur Startseite">
        <div class="flex h-8 w-8 items-center justify-center rounded bg-ink-900 text-ink-50 select-none
                    text-xs font-black tracking-tight transition-transform group-hover:scale-105">
          BN
        </div>
        <span class="font-display font-bold text-lg text-ink-900 leading-none tracking-tight">
          booxnet<span class="text-accent-500">.</span>
        </span>
      </a>

      <!-- Desktop primary nav -->
      <nav class="hidden md:flex items-center gap-0.5 flex-1 justify-center" aria-label="Hauptnavigation">
        {primaryNav.map(link => (
          <a
            href={link.href}
            class:list={[
              'px-3.5 py-1.5 text-sm font-medium transition-colors rounded',
              isActive(link.href)
                ? 'text-ink-900 bg-ink-100'
                : 'text-ink-500 hover:text-ink-900 hover:bg-ink-100',
            ]}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Right actions -->
      <div class="hidden md:flex items-center gap-2">
        <a href="/blog" class="px-3.5 py-1.5 text-sm font-medium text-ink-500 hover:text-ink-900 transition-colors">
          Alle Artikel
        </a>
        <a href="/about"
          class="px-4 py-1.5 rounded-full text-sm font-semibold bg-ink-900 text-ink-50 hover:bg-ink-700 transition-colors">
          Über uns
        </a>
      </div>

      <!-- Mobile burger -->
      <button
        id="mobile-menu-button"
        class="md:hidden p-2 -mr-1 rounded text-ink-600 hover:bg-ink-100 transition-colors"
        aria-label="Menü"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <!-- Hamburger icon -->
        <svg id="icon-open" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <!-- Close icon -->
        <svg id="icon-close" class="h-5 w-5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-ink-200 bg-ink-50">
    <nav class="mx-auto max-w-6xl px-4 py-3 flex flex-col gap-0.5" aria-label="Mobile Navigation">
      {[{ href: '/', label: 'Startseite' }, ...primaryNav, { href: '/about', label: 'Über uns' }].map(link => (
        <a
          href={link.href}
          class:list={[
            'px-3 py-2.5 rounded text-sm font-medium transition-colors',
            isActive(link.href)
              ? 'bg-ink-100 text-ink-900'
              : 'text-ink-600 hover:bg-ink-100 hover:text-ink-900',
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const btn    = document.getElementById('mobile-menu-button');
  const menu   = document.getElementById('mobile-menu');
  const open   = document.getElementById('icon-open');
  const close  = document.getElementById('icon-close');

  btn?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden', isOpen);
    btn.setAttribute('aria-expanded', String(!isOpen));
    open?.classList.toggle('hidden', !isOpen);
    close?.classList.toggle('hidden', isOpen);
  });
</script>
