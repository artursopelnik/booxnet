---
import { type Locale, useTranslations, localizePath, defaultLocale } from '../i18n/ui';

interface Props {
  series: 'tab' | 'note' | 'go' | 'palma';
  count: number;
  lang?: Locale;
}

const { series, count, lang = defaultLocale } = Astro.props;
const t = useTranslations(lang);

const name    = t(`series.${series}` as Parameters<typeof t>[0]);
const tagline = t(`series.${series}.tagline` as Parameters<typeof t>[0]);
---

<a
  href={localizePath(lang, `/blog?series=${series}`)}
  class="group flex flex-col items-center rounded-2xl bg-white border border-ink-200 px-5 pt-8 pb-6 text-center
         transition-all duration-200 hover:shadow-md hover:border-ink-300 hover:-translate-y-0.5"
>
  <!-- Device line-art -->
  <div class="h-20 flex items-center justify-center text-ink-400 group-hover:text-ink-900 transition-colors mb-5">
    {series === 'tab' && (
      <svg class="h-16 w-16" viewBox="0 0 96 96" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
        <rect x="14" y="18" width="56" height="72" rx="6" transform="rotate(-4 42 54)"/>
        <line x1="24" y1="34" x2="56" y2="31.5" opacity="0.45"/>
        <line x1="25" y1="44" x2="52" y2="42" opacity="0.45"/>
        <line x1="26" y1="54" x2="55" y2="52" opacity="0.45"/>
        <path d="M78 30 L60 76 l-2 8 6-6 18-46z" stroke-width="2.5"/>
      </svg>
    )}
    {series === 'note' && (
      <svg class="h-16 w-16" viewBox="0 0 96 96" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
        <rect x="20" y="12" width="56" height="72" rx="6"/>
        <line x1="30" y1="28" x2="66" y2="28" opacity="0.45"/>
        <line x1="30" y1="40" x2="60" y2="40" opacity="0.45"/>
        <line x1="30" y1="52" x2="64" y2="52" opacity="0.45"/>
        <line x1="30" y1="64" x2="54" y2="64" opacity="0.45"/>
      </svg>
    )}
    {series === 'go' && (
      <svg class="h-16 w-16" viewBox="0 0 96 96" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
        <rect x="26" y="16" width="44" height="64" rx="6"/>
        <line x1="35" y1="30" x2="61" y2="30" opacity="0.45"/>
        <line x1="35" y1="40" x2="57" y2="40" opacity="0.45"/>
        <line x1="35" y1="50" x2="60" y2="50" opacity="0.45"/>
        <line x1="42" y1="70" x2="54" y2="70"/>
      </svg>
    )}
    {series === 'palma' && (
      <svg class="h-16 w-16" viewBox="0 0 96 96" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
        <rect x="32" y="14" width="32" height="68" rx="8"/>
        <line x1="40" y1="28" x2="56" y2="28" opacity="0.45"/>
        <line x1="40" y1="38" x2="53" y2="38" opacity="0.45"/>
        <line x1="40" y1="48" x2="55" y2="48" opacity="0.45"/>
        <circle cx="48" cy="72" r="2.5"/>
      </svg>
    )}
  </div>

  <h3 class="text-sm font-bold text-ink-900 mb-1">{name}</h3>
  <p class="text-xs text-ink-500 leading-snug mb-4">{tagline}</p>

  <span class="mt-auto inline-flex items-center gap-1.5 rounded-full border border-ink-300 px-3.5 py-1.5
               text-xs font-semibold text-ink-700 transition-colors
               group-hover:bg-ink-900 group-hover:border-ink-900 group-hover:text-ink-50">
    {count} {count === 1 ? t('series.article') : t('series.articles')}
    <svg class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
      <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.64L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.15-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd"/>
    </svg>
  </span>
</a>
