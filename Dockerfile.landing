# Die Werbeseite von Booxnet (booxnet.tld), in allen Sprachen der App.
#
# Eigenes Abbild, nicht Teil der App: Die App bringt ~400 MB
# Sprachmodelle mit, die Seite ein paar Kilobyte. Zusammen in einem
# Abbild wuerde jede Textkorrektur einen 400-MB-Build ausloesen.
#
# Die Node-Stufe setzt aus landing/template.html und landing/i18n.json
# je Sprache eine fertige Seite zusammen. Keine Abhaengigkeiten, kein
# npm install - reine Textersetzung, damit hier nichts veralten kann.

FROM node:22-alpine AS build
WORKDIR /app

# Wohin der "App oeffnen"-Knopf zeigt, z.B. https://app.booxnet.de
# In Coolify unter Build > Build Arguments setzen.
ARG APP_URL

COPY landing/ ./landing/
COPY scripts/build-landing.mjs ./scripts/
COPY public/icon.svg ./public/icon.svg

RUN node scripts/build-landing.mjs /out

# Ohne Ziel waere der wichtigste Knopf der Seite tot. Lieber der Build
# scheitert hier laut, als dass die Seite still ins Leere zeigt.
RUN test -n "$APP_URL" || { \
      echo "FEHLER: Build-Argument APP_URL fehlt."; \
      echo "Beispiel: --build-arg APP_URL=https://app.booxnet.de"; \
      exit 1; \
    } && \
    grep -rl '__APP_URL__' /out | xargs sed -i "s|__APP_URL__|$APP_URL|g" && \
    ! grep -rq '__APP_URL__' /out

FROM nginx:alpine
COPY --from=build /out /usr/share/nginx/html
COPY docker/nginx-landing.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

# Auf / antwortet eine Weiterleitung - deshalb hier eine Sprachseite
# pruefen, sonst meldete der Test dauerhaft "ungesund".
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s \
  CMD wget -q -O /dev/null http://127.0.0.1/de/ || exit 1
